Rollout patch 0006: a file-backed (mmap) expert source for IQ/native packs.

--mmap-experts used to be Q2_0-only: FileExpertSource demands uniform
BLOB-sized experts.bin (the Q2_0 relayout), while iq_pack --experts-bin writes
the per-layer blob layout the ARENA uses - so IQ packs had no RAM-safe source
and the engine pinned a 47.9 GiB hipHostRegister arena, which OOM-killed the
machine four times under a 96 GiB desktop load. ArenaExpertSource already reads
that exact layout; this patch adds a file-backed mode (set_file_backed) that
mmaps experts.bin and points base_ at the mapping: same bytes, same blob()
offsets, zero pinned RAM, page cache reclaimable. Unpinned by design:
pinned()/device_alias() report false/nullptr and the CPU pool computes experts
(upstream's documented mmap trade, now available for IQ). generate.cpp routes
--mmap-experts to it for native packs. Validation: A/B one-shot, greedy, arena
vs file-backed - identical output ids (results/record-expertsource-ab.json).

--- a/src/core/expert_source.cpp
+++ b/src/core/expert_source.cpp
@@ -628,6 +628,40 @@
     const int64_t blob = (int64_t) lay.max_blob;
     const uint64_t want = lay.total;
 
+    // rollout patch 0006: the file-backed arm. experts.bin (canonical or iq_pack --experts-bin) is already
+    // in this class's blob layout - lay.total bytes, per-layer strides - so mapping it and pointing base_
+    // at the mapping is byte-for-byte the same view the arena would hold, without 47 GiB of pinned anon.
+    // Unpinned by design: pinned()/device_alias() report false/nullptr and the CPU pool computes experts.
+    if (file_backed_) {
+        const std::string fpath = pack_dir + "/experts.bin";
+        const int fd = ::open(fpath.c_str(), O_RDONLY);
+        if (fd < 0) { err = "ArenaExpertSource: cannot open " + fpath + " (file-backed mode needs the iq_pack --experts-bin output)"; return false; }
+        struct stat ms{};
+        if (fstat(fd, &ms) != 0) { ::close(fd); err = "ArenaExpertSource: cannot stat " + fpath; return false; }
+        if ((uint64_t) ms.st_size != want) {
+            char buf[400];
+            std::snprintf(buf, sizeof buf,
+                          "ArenaExpertSource: %s is %llu B but this geometry's expert layout is %llu B - "
+                          "this is not the pack this geometry came from",
+                          fpath.c_str(), (unsigned long long) ms.st_size, (unsigned long long) want);
+            ::close(fd);
+            err = buf;
+            return false;
+        }
+        void* view = mmap(nullptr, (size_t) want, PROT_READ, MAP_SHARED, fd, 0);
+        if (view == MAP_FAILED) { ::close(fd); err = "ArenaExpertSource: mmap failed on " + fpath; return false; }
+        map_fd_ = fd;
+        map_bytes_ = want;
+        base_ = (const uint8_t*) view;
+        blobs_ = n_layers * n_expert;
+        n_expert_ = n_expert;
+        reads_ = 0;
+        pinned_bytes_ = 0;
+        note_ = "experts via mmap of experts.bin (file-backed, unpinned; the page cache holds the hot set)";
+        gib_per_s_ = 0.0;
+        return true;
+    }
+
