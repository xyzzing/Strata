+// ---- rollout patch 0007: the WMMA scorer (opt-in) ---------------------------
+// One wave32 per 16 pooled rows. A = those rows as fp16 (round-to-nearest, the
+// same 10-mantissa-bit loss the tf32 path simulates), staged to shared with rows
+// past `full` zeroed so the fragment always reads a full tile. B = the four query
+// heads as fp16 with the fragment's N dimension zero-padded 4 -> 16 (a col_major
+// fragment over the raw 512-float query buffer would read past its end). K=128
+// runs as 8 rocWMMA 16x16x16 tiles; the accumulator's columns 0..3 are the four
+// head dots. The epilogue is the PORTABLE epilogue, unchanged: per-head ReLU,
+// ORDERED head addition, optional bias, the finite 1e9 tail, cells written in
+// [0, n) only. The WMMA unit's internal accumulation order is unspecified; the
+// error bound that covers it is derived in PORTING.md 12g and asserted by
+// tests/rocm/qsa_score_wmma_parity.cpp.
+constexpr int WROWS = 16;    // pooled rows per WMMA tile (one wave32 each)
+constexpr int WLDDB = 136;   // B staging stride: 16 padded columns, 16-byte-aligned rows
+
+__global__ __launch_bounds__(32, 1) void score_wmma_kernel(
+    const float* __restrict__ pooled, const float* __restrict__ query,
+    const float* __restrict__ bias, const int32_t* __restrict__ step,
+    int max_cells, float* __restrict__ cells) {
+    const int n = step[kStepNKv], full = step[kStepNBid];
+    if(n<1||n>max_cells||step[kStepPos]!=n-1||full!=n/R||
+       step[kStepWidth]!=(n<2051?n:2051))return;
+    const int row0=blockIdx.x*WROWS;
+    if(row0>full)return;
+
+    __shared__ __align__(16) rocwmma::float16_t sA[WROWS][D];
+    __shared__ __align__(16) rocwmma::float16_t sB[16][WLDDB];
+    __shared__ __align__(16) float sC[WROWS][16];
+
+    const int t=threadIdx.x;
+    for(int i=t;i<WROWS*D;i+=32){
+        const int r=i/D,d=i%D;
+        const int row=row0+r;
+        sA[r][d]=row<=full?rocwmma::float16_t(pooled[(size_t)row*D+d]):rocwmma::float16_t(0.0f);
+    }
+    for(int i=t;i<16*WLDDB;i+=32){
+        const int h=i/WLDDB,k=i%WLDDB;
+        sB[h][k]=(h<HEADS&&k<D)?rocwmma::float16_t(query[(size_t)h*D+k]):rocwmma::float16_t(0.0f);
+    }
+    __syncthreads();
+
+    auto fragA=rocwmma::fragment<rocwmma::matrix_a,16,16,16,rocwmma::float16_t,rocwmma::row_major>();
+    auto fragB=rocwmma::fragment<rocwmma::matrix_b,16,16,16,rocwmma::float16_t,rocwmma::col_major>();
+    auto fragAcc=rocwmma::fragment<rocwmma::accumulator,16,16,16,rocwmma::float32_t>();
+    rocwmma::fill_fragment(fragAcc,0.0f);
+    for(int k0=0;k0<D;k0+=16){
+        rocwmma::load_matrix_sync(fragA,&sA[0][0]+k0,D);
+        rocwmma::load_matrix_sync(fragB,&sB[0][0]+k0,WLDDB);
+        rocwmma::mma_sync(fragAcc,fragA,fragB,fragAcc);
+    }
+    rocwmma::store_matrix_sync(&sC[0][0],fragAcc,16,rocwmma::mem_row_major);
+    __syncthreads();
+
+    for(int r=t;r<WROWS;r+=32){
+        const int row=row0+r;
+        if(row>full)continue;
+        float h[HEADS];
+        for(int j=0;j<HEADS;++j)h[j]=fmaxf(__fadd_rn(0.0f,sC[r][j]),0.0f);
+        float sum=__fadd_rn(__fadd_rn(__fadd_rn(h[0],h[1]),h[2]),h[3]);
+        if(bias)sum=__fadd_rn(sum,bias[row]);
+        sum=__fadd_rn(sum,row==full&&n%R?1e9f:0.0f);
+        sum=__fadd_rn(sum,0.0f);
+        for(int i=row*R;i<n&&i<(row+1)*R;++i)cells[i]=sum;
+    }
+}
